# =========================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - PORTAL CELC (FRONTEND)
# Copia este archivo como '.env.local' y llena los valores correspondientes.
# No subas el archivo '.env.local' a GitHub (ya está en el .gitignore).
# =========================================================================

# URL base de la API del Backend (cambiar según el entorno)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Entorno de ejecución (development, production, test)
NODE_ENV=development

# Configuraciones públicas adicionales (ejemplo para servicios de autenticación o analytics)
# NEXT_PUBLIC_ANALYTICS_ID=tu_id_aqui
